{
    "version": 2,
    "builds": [
        {
            "src": "config/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "buildCommand": "bash build_files.sh",
                "includeFiles": [
                    "templates/**/*",
                    "blog/templates/**/*",
                    "core/templates/**/*",
                    "static/**/*",
                    "staticfiles/**/*"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "config/wsgi.py"
        }
    ]
}